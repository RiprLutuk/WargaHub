{
  "name": "@wargahub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "worker": "bun src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun src/db/migrate.ts",
    "db:bootstrap": "bun src/bootstrap.ts",
    "db:test-migrate": "bun src/db/migrate.test-runner.ts",
    "db:seed": "bun src/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.7",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@node-rs/argon2": "^2.0.2",
    "@wargahub/contracts": "workspace:*",
    "fastify": "^5.4.0",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.3",
    "ulidx": "^2.4.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
